file(MAKE_DIRECTORY "${HEIRAN_ASSOCIATION_TEST_DIR}")
file(TO_NATIVE_PATH "${HEIRAN_NSIS_SOURCE_DIR}" nsis_dir)
set(all_extensions .hrn .png .jpg .jpeg .bmp .gif .webp .avif .jxl .psd .tif .tiff .exr .hdr .dpx .tga)
foreach(mode IN ITEMS DEFAULT EXCLUDED NONE)
  set(executable "${HEIRAN_ASSOCIATION_TEST_DIR}/${mode}.exe")
  set(output "${HEIRAN_ASSOCIATION_TEST_DIR}/${mode}.txt")
  file(TO_NATIVE_PATH "${executable}" executable_native)
  file(TO_NATIVE_PATH "${output}" output_native)
  set(arguments /V2 "/DHEIRAN_NSIS_ASSET_DIR=${nsis_dir}"
    "/DHEIRAN_TEST_EXECUTABLE=${executable_native}" "/DHEIRAN_TEST_OUTPUT=${output_native}")
  if(NOT mode STREQUAL "DEFAULT")
    list(APPEND arguments "/DHEIRAN_TEST_${mode}")
  endif()
  execute_process(COMMAND "${HEIRAN_MAKENSIS}" ${arguments}
    "${CMAKE_CURRENT_LIST_DIR}/InstallerAssociationSelection.nsi"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not compile association selection test: ${log}\n${error}")
  endif()
  file(REMOVE "${output}")
  execute_process(COMMAND "${executable}" RESULT_VARIABLE result TIMEOUT 10)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Association selection test did not complete: ${result}")
  endif()
  file(STRINGS "${output}" selected)
  set(expected ${all_extensions})
  if(mode STREQUAL "EXCLUDED")
    list(REMOVE_ITEM expected .hrn .png .jpeg .exr)
  elseif(mode STREQUAL "NONE")
    set(expected "")
  endif()
  if(NOT "${selected}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected ${mode} associations: ${selected}; expected ${expected}")
  endif()
endforeach()
