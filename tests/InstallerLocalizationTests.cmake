include("${HEIRAN_CPACK_CONFIG}")
if(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL)
  message(FATAL_ERROR "Opening or cancelling the installer must not uninstall the existing version.")
endif()

file(READ "${HEIRAN_CPACK_TEMPLATE}" template)
foreach(reference IN ITEMS "$(HeiranUpgradePrompt)" "$(HeiranUninstallFailed)" "association_page.nsh"
    "association_sections.nsh" "association_descriptions.nsh")
  string(FIND "${template}" "${reference}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Installer message is not localized: ${reference}")
  endif()
endforeach()
if(template MATCHES "is already installed" OR template MATCHES "Uninstall failed[.]")
  message(FATAL_ERROR "Hard-coded English upgrade message remains in the installer.")
endif()
string(REGEX MATCHALL "!insertmacro MUI_LANGUAGE \"[^\"]+\"" languages "${template}")
list(LENGTH languages language_count)
if(NOT language_count EQUAL 2)
  message(FATAL_ERROR "Expected English and Japanese installer languages.")
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${root}/resources/nsis/association_sections.nsh" sections)
file(READ "${root}/resources/nsis/association_descriptions.nsh" descriptions)
foreach(name IN ITEMS Hrn Image Hdr)
  foreach(kind IN ITEMS Name Description)
    string(FIND "${sections}\n${descriptions}" "$(HeiranAssociation${name}${kind})" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "Component text is not localized: ${name}${kind}")
    endif()
  endforeach()
endforeach()
