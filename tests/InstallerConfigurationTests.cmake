include("${BUILD_DIR}/CPackConfig.cmake")
if(NOT CPACK_GENERATOR STREQUAL "INNOSETUP;ZIP"
    OR NOT CPACK_MONOLITHIC_INSTALL
    OR NOT CPACK_INNOSETUP_SETUP_PrivilegesRequired STREQUAL "lowest"
    OR NOT CPACK_INNOSETUP_SETUP_PrivilegesRequiredOverridesAllowed STREQUAL "dialog"
    OR NOT CPACK_INNOSETUP_LANGUAGES STREQUAL "english;japanese")
  message(FATAL_ERROR "Installer scope, packaging, or language configuration changed.")
endif()

function(check_compiler_discovery)
  set(CPACK_HEIRAN_INNOSETUP_DIR "${BUILD_DIR}/installer/compiler-lookup")
  set(CPACK_INNOSETUP_EXECUTABLE "")
  set(CPACK_GENERATOR ZIP)
  include("${CPACK_PROJECT_CONFIG_FILE}")
  if(CPACK_INNOSETUP_EXECUTABLE)
    message(FATAL_ERROR "ZIP packaging should not resolve an installer compiler.")
  endif()

  set(compiler "${CPACK_HEIRAN_INNOSETUP_DIR}/ISCC.exe")
  file(WRITE "${compiler}" "")
  set(CPACK_GENERATOR INNOSETUP)
  include("${CPACK_PROJECT_CONFIG_FILE}")
  if(NOT CPACK_INNOSETUP_EXECUTABLE STREQUAL compiler)
    message(FATAL_ERROR "The portable compiler was not discovered during packaging.")
  endif()
endfunction()
check_compiler_discovery()

file(READ "${BUILD_DIR}/installer/associations.iss" associations)
file(READ "${SCRIPT_DIR}/messages.iss" messages)
function(require_text contents expected)
  string(FIND "${${contents}}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing '${expected}' in ${contents}.")
  endif()
endfunction()

string(REGEX MATCHALL "\nName: [a-z]+(\\\\[a-z]+)?" declarations "${associations}")
set(tasks "")
foreach(declaration IN LISTS declarations)
  string(REPLACE "\nName: " "" task "${declaration}")
  list(APPEND tasks "${task}")
endforeach()
set(expected_tasks hrn common)
foreach(extension IN ITEMS png jpg jpeg bmp gif webp avif jxl psd tif tiff)
  list(APPEND expected_tasks "common\\${extension}")
endforeach()
list(APPEND expected_tasks precision)
foreach(extension IN ITEMS exr hdr dpx tga)
  list(APPEND expected_tasks "precision\\${extension}")
endforeach()
if(NOT tasks STREQUAL expected_tasks OR associations MATCHES "Flags: unchecked")
  message(FATAL_ERROR "Association tasks must be ordered and checked by default.")
endif()

foreach(task IN LISTS tasks)
  if(task MATCHES "\\\\([a-z]+)$")
    set(key "Software\\Classes\\.${CMAKE_MATCH_1}\\OpenWithProgids")
    set(prefix "Root: HKA; Subkey: \"${key}\"; ValueName: \"Heiran.Image\"")
    require_text(associations "${prefix}; ValueType: string; ValueData: \"\"; Flags: uninsdeletevalue; Tasks: ${task}")
    require_text(associations "${prefix}; Flags: deletevalue dontcreatekey; Tasks: not ${task}")
  endif()
endforeach()
foreach(language IN ITEMS english japanese)
  foreach(message_key IN ITEMS WizardSelectTasks SelectTasksLabel2 Heiran_AssociationTypes
      Heiran_common Heiran_precision Heiran_RuntimeMissing Heiran_LegacyInstallDir
      Heiran_OtherScopeDir Heiran_LegacyCleanupFailed)
    require_text(messages "${language}.${message_key}=")
  endforeach()
endforeach()
