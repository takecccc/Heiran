function(heiran_localize_nsis_template output_dir)
  set(source "${CMAKE_ROOT}/Modules/Internal/CPack/NSIS.template.in")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(READ "${source}" template)
  set(upgrade [=[$1 is already installed. $\n$\nDo you want to uninstall the old version before installing the new one?]=])
  foreach(message IN ITEMS "${upgrade}" "Uninstall failed.")
    string(FIND "${template}" "${message}" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "CPack's NSIS upgrade messages changed. Review InstallerLocalization.cmake.")
    endif()
  endforeach()
  string(REPLACE "${upgrade}" "$(HeiranUpgradePrompt)" template "${template}")
  string(REPLACE "Uninstall failed." "$(HeiranUninstallFailed)" template "${template}")
  set(language_pattern "  !insertmacro MUI_LANGUAGE \"English\"[^\n]*\n(  !insertmacro MUI_LANGUAGE \"[^\"]+\"[^\n]*\n)+")
  string(REGEX MATCH "${language_pattern}" languages "${template}")
  if(NOT languages)
    message(FATAL_ERROR "CPack's NSIS language block changed. Review InstallerLocalization.cmake.")
  endif()
  file(TO_NATIVE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/resources/nsis/localization.nsh" localization)
  string(REPLACE "${languages}"
    "  !insertmacro MUI_LANGUAGE \"English\"\n  !insertmacro MUI_LANGUAGE \"Japanese\"\n  !include \"${localization}\"\n"
    template "${template}")
  file(MAKE_DIRECTORY "${output_dir}")
  file(WRITE "${output_dir}/NSIS.template.in" "${template}")
endfunction()
